{# Shared summary card: title (optional), all-time count, full-history heatmap,
   and top tags. #}
<section
    id="activity-section-summary-{{ activity_id }}"
    class="flex flex-col gap-4 rounded-card border border-border bg-surface-1 p-4"
    {% if is_owner | default(false) %}
    hx-get="/activities/{{ activity_id }}/stats-summary"
    hx-trigger="log-saved from:body"
    hx-swap="outerHTML"
    {% endif %}
>
    {% if card_name is defined and card_name %}
    {% if title_editable | default(false) %}
    <div id="activity-header-rename" class="flex items-center gap-3">
        <div class="flex-1">
        {% if is_secret | default(false) %}
        <span class="flex-shrink-0 inline-flex items-center rounded-full bg-brand-subtle px-2 py-0.5 text-xs font-medium text-on-brand">{{ strings.ACTIVITY_SECRET_BADGE }}</span>
        {% endif %}
        </div>
        <h1 class="min-w-0 flex-1 truncate text-center text-title font-semibold text-text-primary">{{ card_name }}</h1>
        <div class="flex flex-1 justify-end">
            <button
                type="button"
                aria-label="{{ strings.RENAME_LABEL }}"
                hx-get="/activities/{{ activity_id }}/rename-form"
                hx-target="#activity-dialog-rename"
                hx-swap="outerHTML"
                class="flex size-7 items-center justify-center rounded text-text-muted transition hover:text-text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
            >{{ icon('pencil', size=18) }}</button>
        </div>
    </div>
    {% elif is_secret | default(false) %}
    <div class="flex items-center">
        <div class="flex flex-1">
            <span class="rounded-full bg-brand-subtle px-2 py-0.5 inline-flex items-center text-xs font-medium text-on-brand">{{ strings.ACTIVITY_SECRET_BADGE }}</span>
        </div>
        <h2 class="min-w-0 flex-1 truncate text-center text-title font-semibold text-text-primary">{{ card_name }}</h2>
        <div class="flex flex-1"></div>
    </div>
    {% else %}
    <h2 class="truncate text-center text-title font-semibold text-text-primary">{{ card_name }}</h2>
    {% endif %}
    <div class="-mx-4 border-t border-border"></div>
    {% endif %}

    <div class="flex flex-row gap-3">
        <dl class="flex-1 bg-surface-0 px-3 py-2">
            <div class="flex items-center justify-between gap-3">
                <dt class="text-caption text-text-muted">{{ strings.STATS_AVERAGE_WEEKLY_LABEL }}</dt>
                <dd class="text-title font-medium text-text-primary">{{ average_weekly_count | default(0) | format_average_weekly_count }}</dd>
            </div>
        </dl>
        <dl class="flex-1 bg-surface-0 px-3 py-2">
            <div class="flex items-center justify-between gap-3">
                <dt class="text-caption text-text-muted">{{ strings.STATS_AVERAGE_MONTHLY_LABEL }}</dt>
                <dd class="text-title font-medium text-text-primary">{{ average_monthly_count | default(0) | format_average_weekly_count }}</dd>
            </div>
        </dl>
        <dl class="flex-1 bg-surface-0 px-3 py-2">
            <div class="flex items-center justify-between gap-3">
                <dt class="text-caption text-text-muted">{{ strings.STATS_PERIOD_LIFETIME }}</dt>
                <dd class="text-title font-medium text-text-primary">{{ counts.lifetime | format_count }}</dd>
            </div>
        </dl>
    </div>
    <div class="flex flex-col gap-4">
        {% if heatmap %}
        {% set active_weeks = heatmap | selectattr('intensity', 'gt', 0) | list | length %}
        <div class="flex flex-col gap-1" data-heatmap-timeline>
            <div class="flex items-center justify-between gap-3">
                <button
                    type="button"
                    hidden
                    data-heatmap-now
                    class="min-h-tap rounded-button px-2 text-caption text-text-secondary transition hover:bg-surface-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-strong"
                >{{ strings.HEATMAP_NOW }}</button>
            </div>
            <div class="overflow-x-auto overscroll-contain" data-heatmap-scroll tabindex="0">
                <div class="flex w-max min-w-full gap-px" aria-hidden="true">
                    {% for week in heatmap %}
                    <span class="w-3 shrink-0 whitespace-nowrap text-caption text-text-muted">
                        {% if week.quarter_month %}
                            {% set month_label = strings.HEATMAP_QUARTER_LABELS[week.quarter_month] %}
                            {{ strings.HEATMAP_JANUARY_LABEL.format(month=month_label, year=week.quarter_year) if week.quarter_month == 1 else month_label }}
                        {% endif %}
                    </span>
                    {% endfor %}
                </div>
                <div
                    role="group"
                    aria-label="{{ strings.HEATMAP_ARIA.format(start=heatmap[0].start, end=heatmap[-1].end, active_weeks=active_weeks) }}"
                    class="flex h-12 w-max min-w-full items-end gap-px"
                >
                    {% for week in heatmap %}
                        {% set height_pct = (week.intensity / 7 * 100) | round(1) if week.intensity else 0 %}
                        <span
                            aria-hidden="true"
                            class="w-3 shrink-0 {% if week.intensity > 0 %}bg-heatmap-bar{% else %}bg-heatmap-baseline{% endif %}"
                            style="height: {{ height_pct if week.intensity else 2 }}{% if week.intensity %}%{% else %}px{% endif %}"
                        ></span>
                    {% endfor %}
                </div>
            </div>
        </div>
        {% else %}
        <p class="text-caption text-text-muted">{{ strings.HEATMAP_EMPTY }}</p>
        {% endif %}

    {% include "components/activities/_top_tags_content.html.jinja2" with context %}
    </div>
    {% if created_at %}
    <p class="self-end text-xs text-text-muted">{{ strings.ACTIVITY_TRACKING_SINCE.format(date=created_at[:10]) }}</p>
    {% endif %}
</section>
