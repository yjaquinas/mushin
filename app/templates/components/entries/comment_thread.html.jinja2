{# Context: activity_id, entry_id, username, comments, can_comment,
   viewer_logged_in, current_user_id, entry_owner_id, slug #}
<div id="comment-thread-{{ entry_id }}" class="flex flex-col gap-3 pt-2">
    {% if not comments %}
    <p class="text-caption text-text-muted">{{ strings.COMMENTS_EMPTY }}</p>
    {% else %}
    <ul class="flex flex-col gap-3">
        {% for comment in comments %}
        <li id="comment-{{ comment.id }}" class="flex flex-col gap-0">
            {% set is_reply = false %}
            {% set thread_can_reply = can_comment and not comment.deleted_at %}
            {% set can_reply = thread_can_reply %}
            {% include "components/entries/_comment_item.html.jinja2" %}
            <div id="comment-reply-form-{{ comment.id }}"></div>
            {% if comment.replies %}
            <ul class="ms-4 flex flex-col gap-0 border-s border-border ps-3">
                {% for reply in comment.replies %}
                <li id="comment-{{ reply.id }}" class="flex flex-col gap-0">
                    {% set is_reply = true %}
                    {% set parent_comment = comment %}
                    {% set comment = reply %}
                    {% set can_reply = thread_can_reply %}
                    {% include "components/entries/_comment_item.html.jinja2" %}
                    <div id="comment-reply-form-{{ comment.id }}"></div>
                </li>
                {% endfor %}
            </ul>
            {% endif %}
        </li>
        {% endfor %}
    </ul>
    {% endif %}

    {% if can_comment %}
    <form
        hx-post="/@{{ username }}/{{ slug }}/entries/{{ entry_id }}/comments"
        hx-target="#comment-thread-{{ entry_id }}"
        hx-swap="outerHTML"
        class="flex items-end gap-2"
        data-comment-form
    >
        <label for="comment-body-{{ entry_id }}" class="sr-only">{{ strings.COMMENTS_BODY_LABEL }}</label>
        <textarea
            id="comment-body-{{ entry_id }}"
            name="body"
            rows="2"
            required
            placeholder="{{ strings.COMMENTS_BODY_PLACEHOLDER }}"
            data-comment-max-lines="5"
            data-comment-max-chars="200"
            data-comment-max-lines-message="{{ strings.COMMENTS_BODY_MAX_LINES_REACHED }}"
            data-comment-max-chars-message="{{ strings.COMMENTS_BODY_MAX_CHARS_REACHED }}"
            class="min-h-tap flex-1 resize-none overflow-hidden rounded-card border border-border bg-surface-1 p-2 text-body text-text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
        ></textarea>
        <div class="flex shrink-0 flex-col items-end gap-1">
            <span class="text-caption text-text-muted" data-comment-char-count>0/200</span>
            <button type="submit" class="min-h-tap shrink-0 rounded-button bg-brand px-4 text-body font-semibold text-on-brand transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2">{{ strings.COMMENTS_SUBMIT }}</button>
        </div>
    </form>
    {% elif not viewer_logged_in %}
    <a href="/" class="text-caption text-text-muted underline-offset-2 hover:underline focus-visible:outline-offset-2">{{ strings.COMMENTS_LOGIN_TO_COMMENT }}</a>
    {% endif %}
</div>
