{% if closed %}
<div id="comment-reply-form-{{ comment.id }}"></div>
{% else %}
<div id="comment-reply-form-{{ comment.id }}" class="border-s border-border ps-3">
    <form
        hx-post="/@{{ username }}/{{ slug }}/entries/{{ entry_id }}/comments/{{ comment.id }}/replies"
        hx-target="#comment-thread-{{ entry_id }}"
        hx-swap="outerHTML"
        class="flex flex-col gap-2 rounded-card bg-surface-2 p-3"
        data-comment-form
    >
        <p id="reply-context-{{ comment.id }}" class="text-caption font-medium text-text-secondary">
            {{ strings.COMMENTS_REPLYING_TO.format(author=comment.author_username) }}
        </p>
        <label for="reply-body-{{ comment.id }}" class="sr-only">
            {{ strings.COMMENTS_REPLY_BODY_LABEL.format(author=comment.author_username) }}
        </label>
        <textarea
            id="reply-body-{{ comment.id }}"
            name="body"
            rows="2"
            required
            autofocus
            aria-describedby="reply-context-{{ comment.id }}"
            placeholder="{{ strings.COMMENTS_REPLY_BODY_PLACEHOLDER }}"
            data-comment-max-lines="5"
            data-comment-max-chars="200"
            data-comment-max-lines-message="{{ strings.COMMENTS_BODY_MAX_LINES_REACHED }}"
            data-comment-max-chars-message="{{ strings.COMMENTS_BODY_MAX_CHARS_REACHED }}"
            class="min-h-tap resize-none overflow-hidden rounded-card border border-border bg-surface-1 p-2 text-body text-text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
        ></textarea>
        <div class="flex items-center justify-between gap-2">
            <span class="text-caption text-text-muted" data-comment-char-count>0/200</span>
            <div class="flex items-center gap-2">
                <button
                    type="button"
                    hx-get="/@{{ username }}/{{ slug }}/entries/{{ entry_id }}/comments/{{ comment.id }}/reply-form?closed=1"
                    hx-target="#comment-reply-form-{{ comment.id }}"
                    hx-swap="outerHTML"
                    class="min-h-tap rounded-button px-3 text-body font-medium text-text-secondary transition hover:bg-surface-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
                >{{ strings.COMMENTS_REPLY_CANCEL }}</button>
                <button
                    type="submit"
                    class="min-h-tap rounded-button bg-brand px-4 text-body font-semibold text-on-brand transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
                >{{ strings.COMMENTS_SUBMIT }}</button>
            </div>
        </div>
    </form>
</div>
{% endif %}
